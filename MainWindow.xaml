<Window x:Class="ProdutosApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produtos" Height="540" Width="960"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Formulário + Menu de opções -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Dados do produto" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Text="Id (usado em Buscar/Atualizar/Excluir)"/>
            <TextBox x:Name="txtId" Margin="0,2,0,8" Padding="4"/>

            <TextBlock Text="Nome"/>
            <TextBox x:Name="txtNome" Margin="0,2,0,8" Padding="4" MaxLength="100"/>

            <TextBlock Text="Preço (R$)"/>
            <TextBox x:Name="txtPreco" Margin="0,2,0,8" Padding="4"/>

            <TextBlock Text="Estoque"/>
            <TextBox x:Name="txtEstoque" Margin="0,2,0,8" Padding="4"/>

            <TextBlock Text="Categoria"/>
            <TextBox x:Name="txtCategoria" Margin="0,2,0,12" Padding="4" MaxLength="50"/>

            <TextBlock Text="Menu" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
            <UniformGrid Columns="2">
                <Button Content="1. Inserir"      Margin="2" Padding="6" Click="BtnInserir_Click"/>
                <Button Content="2. Listar"       Margin="2" Padding="6" Click="BtnListar_Click"/>
                <Button Content="3. Buscar por ID" Margin="2" Padding="6" Click="BtnBuscar_Click"/>
                <Button Content="4. Atualizar"    Margin="2" Padding="6" Click="BtnAtualizar_Click"/>
                <Button Content="5. Excluir"      Margin="2" Padding="6" Click="BtnExcluir_Click"/>
                <Button Content="6. Sair"         Margin="2" Padding="6" Click="BtnSair_Click"/>
            </UniformGrid>
            <Button Content="Limpar campos" Margin="2,6,2,0" Padding="4" Click="BtnLimpar_Click"/>
        </StackPanel>

        <!-- Grade de produtos -->
        <DataGrid x:Name="dgProdutos" Grid.Row="0" Grid.Column="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionChanged="DgProdutos_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Preço"
                                    Binding="{Binding Preco, StringFormat=C2, ConverterCulture=pt-BR}"
                                    Width="100"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="70"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra de status -->
        <TextBlock x:Name="txtStatus" Grid.Row="1" Grid.ColumnSpan="2"
                   Margin="0,10,0,0" Foreground="DimGray" Text="Pronto."/>
    </Grid>
</Window>
